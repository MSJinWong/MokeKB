# Postgres
POSTGRES_USER=maxkb
POSTGRES_PASSWORD=ChangeMe_Pg_123
POSTGRES_DB=maxkb

# Redis
REDIS_PASSWORD=ChangeMe_Redis_123

# Django secret (used as MAXKB_SECRET_KEY in compose)
MAXKB_DJANGO_SECRET_KEY=ChangeMe_Secret_64bytes_random

# Provider whitelist
# "all" enables every provider shown on the model page (recommended).
# For a lightweight install, replace with a comma-separated subset.
MAXKB_ENABLED_PROVIDERS=all

# Optional toggles
MAXKB_ENABLE_API_DOCS=false
MAXKB_ENABLE_EMAIL=false

# Public-facing port for nginx
MAXKB_PUBLIC_PORT=8080
