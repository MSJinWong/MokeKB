# Postgres
POSTGRES_USER=maxkb
POSTGRES_PASSWORD=ChangeMe_Pg_123
POSTGRES_DB=maxkb

# Redis
REDIS_PASSWORD=ChangeMe_Redis_123

# Django secret (used as MAXKB_SECRET_KEY in compose)
MAXKB_DJANGO_SECRET_KEY=ChangeMe_Secret_64bytes_random

# Provider whitelist — set to "all" to enable all 20 providers
# Default: 5 cloud + 4 local, covering text / image / audio / video modalities
MAXKB_ENABLED_PROVIDERS=model_openai_provider,model_anthropic_provider,model_siliconCloud_provider,aliyun_bai_lian_model_provider,model_volcanic_engine_provider,model_ollama_provider,model_vllm_provider,model_xinference_provider,model_docker_ai_provider

# Optional toggles
MAXKB_ENABLE_API_DOCS=false
MAXKB_ENABLE_EMAIL=false

# Public-facing port for nginx
MAXKB_PUBLIC_PORT=8080
