# UI image: nginx + built admin/chat dist, proxies /admin/api/ + /chat/api/ to backend.
FROM node:24-alpine AS web-build
WORKDIR /build
COPY ui /build/ui
WORKDIR /build/ui
RUN npm install --prefer-offline --no-audit && \
    NODE_OPTIONS="--max-old-space-size=4096" \
    npx -y concurrently --kill-others-on-fail "npm run build" "npm run build-chat"

FROM nginx:1.27-alpine
# Vite build outputs to ui/dist/admin and ui/dist/chat (driven by VITE_BASE_PATH).
COPY --from=web-build /build/ui/dist/admin /usr/share/nginx/html/admin
COPY --from=web-build /build/ui/dist/chat /usr/share/nginx/html/chat
COPY installer/nginx.ui.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
