# Backend-only deployment env. Copy to .env and fill in.
# Used by: docker compose -f installer/docker-compose.app-only.yml --env-file .env up -d

# === Image ===
# Pin to a real tag in prod. After first CI run, replace `:dev` with `:v2.8.1` etc.
# Offline scenario: load tar with `docker load < hoyanai-app-<tag>-linux-amd64.tar.gz`
# then set this to the loaded image:tag.
MAXKB_IMAGE=ghcr.io/msjinwong/hoyanai-app:dev

# === Backend listener (host port mapped to container 8080) ===
# Frontend nginx proxies /admin/api/ and /chat/api/ to this port.
MAXKB_BACKEND_PORT=8080

# === PostgreSQL (pgvector required) ===
# Default assumes PG was installed by installer/install-postgres.sh on THIS host.
# That script binds PG to 127.0.0.1:5432; backend containers reach it via
# host.docker.internal (host-gateway), configured in docker-compose.app-only.yml.
#
# Alternatives:
#   - PG inside docker on same host but on a shared network → use its container name
#   - PG on another machine → put that machine's LAN IP/hostname here
MAXKB_DB_HOST=host.docker.internal
MAXKB_DB_PORT=5432
MAXKB_DB_USER=hoyanai
MAXKB_DB_PASSWORD=ChangeMe_Pg_123
MAXKB_DB_NAME=hoyanai
MAXKB_DB_MAX_OVERFLOW=80

# === Redis ===
# Default: in-stack Redis service (see docker-compose.app-only.yml).
# That service binds to 127.0.0.1:6379 on the host, so the default password
# below ("123456") is only exposed to localhost. If you change the port binding
# to 0.0.0.0:6379 (LAN access), CHANGE THIS PASSWORD to something strong.
#
# To use an EXTERNAL Redis instead: set MAXKB_REDIS_HOST to that host's IP
# (or host.docker.internal for host-machine Redis), and remove the redis
# service from docker-compose.app-only.yml (or `docker compose up -d --scale redis=0`).
MAXKB_REDIS_HOST=redis
MAXKB_REDIS_PORT=6379
MAXKB_REDIS_PASSWORD=123456
MAXKB_REDIS_DB=0

# === Django secret (64+ random bytes; generate with: openssl rand -hex 32) ===
MAXKB_DJANGO_SECRET_KEY=ChangeMe_Secret_64bytes_random

# === Provider whitelist ===
# "all" enables every provider shown on the model page (recommended).
# For a lightweight install, replace with a comma-separated subset, e.g.
# model_openai_provider,model_ollama_provider
MAXKB_ENABLED_PROVIDERS=all

# === Optional toggles ===
MAXKB_ENABLE_API_DOCS=false
MAXKB_ENABLE_EMAIL=false
