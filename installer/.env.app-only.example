# Backend-only deployment env. Copy to .env and fill in.
# Used by: docker compose -f installer/docker-compose.app-only.yml --env-file .env up -d

# === Image ===
# Pin to a real tag in prod. After first CI run, replace `:dev` with `:v2.8.1` etc.
# Offline scenario: load tar with `docker load < mokekb-app-<tag>-linux-amd64.tar.gz`
# then set this to the loaded image:tag.
MAXKB_IMAGE=ghcr.io/msjinwong/mokekb-app:dev

# === Backend listener (host port mapped to container 8080) ===
# Frontend nginx proxies /admin/api/ and /chat/api/ to this port.
MAXKB_BACKEND_PORT=8080

# === External PostgreSQL (pgvector required) ===
# - PG inside docker on same host? use its container name on a shared network.
# - PG on the host machine (Linux)? use the host's LAN IP (NOT 127.0.0.1 — that's the container).
# - PG on host (Mac/Windows Docker Desktop)? use host.docker.internal.
MAXKB_DB_HOST=192.168.x.x
MAXKB_DB_PORT=5432
MAXKB_DB_USER=maxkb
MAXKB_DB_PASSWORD=ChangeMe_Pg_123
MAXKB_DB_NAME=maxkb
MAXKB_DB_MAX_OVERFLOW=80

# === External Redis ===
MAXKB_REDIS_HOST=192.168.x.x
MAXKB_REDIS_PORT=6379
MAXKB_REDIS_PASSWORD=ChangeMe_Redis_123
MAXKB_REDIS_DB=0

# === Django secret (64+ random bytes; generate with: openssl rand -hex 32) ===
MAXKB_DJANGO_SECRET_KEY=ChangeMe_Secret_64bytes_random

# === Provider whitelist (set to "all" to enable all 20) ===
MAXKB_ENABLED_PROVIDERS=model_openai_provider,model_anthropic_provider,model_siliconCloud_provider,aliyun_bai_lian_model_provider,model_volcanic_engine_provider,model_ollama_provider,model_vllm_provider,model_xinference_provider,model_docker_ai_provider

# === Optional toggles ===
MAXKB_ENABLE_API_DOCS=false
MAXKB_ENABLE_EMAIL=false
